# Node / Nx
node_modules/
.nx/
tmp/
*.log

# Lua tooling artifacts
luacov.stats.out
luacov.report.out
.luarocks/

# Addon build output + vendored libraries (fetched from .pkgmeta externals — never committed).
# Scope the Libs ignore to projects/ so it does NOT also swallow the repo-root libs/ SOURCE on
# case-insensitive filesystems (macOS core.ignorecase: bare **/Libs/ matches libs/). Shipped
# shared-lib source under /libs/ stays tracked; only vendored per-addon Libs/ are ignored.
**/.release/
projects/**/Libs/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — personal/local config (skills + shared settings stay committed)
.claude/settings.local.json
