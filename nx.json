{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/.luacheckrc",
      "{workspaceRoot}/stylua.toml",
      "{workspaceRoot}/.busted"
    ],
    "lua": ["{projectRoot}/**/*.lua"],
    "mock": ["{workspaceRoot}/tools/wow-mock/**/*.lua"]
  },
  "targetDefaults": {
    "format-check": { "cache": true, "inputs": ["lua", "sharedGlobals"] },
    "format": { "cache": false },
    "lint": { "cache": true, "inputs": ["lua", "sharedGlobals"] },
    "test": { "cache": true, "inputs": ["default", "mock", "sharedGlobals"] },
    "build": { "cache": false }
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": ["badger-ttk", "badger-arena"],
    "releaseTag": { "pattern": "{projectName}/{version}" },
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "specifierSource": "conventional-commits",
      "versionActions": "./tools/release/toc-version-actions.js",
      "git": { "commit": false, "tag": false, "push": false }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true,
      "automaticFromRef": true,
      "git": { "commit": false, "tag": false, "push": false }
    }
  },
  "defaultBase": "main"
}
